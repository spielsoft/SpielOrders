{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spielorders.app/schemas/v1/order.schema.json",
  "title": "SpielOrders order.json schema version 1",
  "$defs": {
    "uuid_v4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nonblank": {
      "type": "string",
      "pattern": "\\S"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "quantity", "unit_price"],
      "properties": {
        "description": {
          "$ref": "#/$defs/nonblank"
        },
        "quantity": {
          "type": "number"
        },
        "unit_price": {
          "type": "number"
        },
        "catalog_number": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_root",
    "order_id",
    "title",
    "date_ordered",
    "status",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_root": {
      "type": "string",
      "pattern": "^(?:\\.\\./)+\\.\\.$"
    },
    "order_id": {
      "$ref": "#/$defs/uuid_v4"
    },
    "title": {
      "$ref": "#/$defs/nonblank"
    },
    "date_ordered": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "status": {
      "enum": ["in_preparation", "hold", "ordered", "received", "complete"]
    },
    "vendor_id": {
      "$ref": "#/$defs/uuid_v4"
    },
    "orderer": {
      "type": "string"
    },
    "ordering_institution": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "project": {
      "type": "string"
    },
    "order_group": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  }
}
